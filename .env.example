# Copy this file to .env.local for local testing.
# In Vercel, add these same names under Project Settings -> Environment Variables.

# From console.anthropic.com -> API Keys. NEVER put this in a VITE_ variable — it must stay server-side only.
ANTHROPIC_API_KEY=

# From your Supabase project -> Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
